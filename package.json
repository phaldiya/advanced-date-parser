{
  "name": "advanced-date-parser",
  "description": "A date parser middleware, to parse date into Javascript Date Objects",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "author": "Pradeep K Haldiya <pradeep.haldiya@gmail.com>",
  "keywords": [
    "express",
    "expressjs",
    "date",
    "datetime",
    "middleware",
    "ts",
    "typescript",
    "types",
    "typing",
    "typings",
    "body",
    "query",
    "pradeep",
    "haldiya"
  ],
  "scripts": {
    "build": "tsup && bun run build:types",
    "build:types": "tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('dist/index.d.ts','dist/index.d.mts')\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "verify": "bun run lint && bun run typecheck && bun run build && bun run test",
    "prepublishOnly": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phaldiya/advanced-date-parser.git"
  },
  "bugs": {
    "url": "https://github.com/phaldiya/advanced-date-parser/issues"
  },
  "homepage": "https://github.com/phaldiya/advanced-date-parser#readme",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "semantic-release": "^25.0.8",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
